<?xml version="1.0" encoding="utf-8"?>
<!-- The saved phone and PIN live in WebView storage; they move with a device-to-device transfer but never go to cloud backup. -->
<data-extraction-rules>
    <cloud-backup><exclude domain="root" path="." /><exclude domain="database" path="." /><exclude domain="sharedpref" path="." /><exclude domain="file" path="." /></cloud-backup>
    <device-transfer><include domain="root" path="app_webview/" /></device-transfer>
</data-extraction-rules>
